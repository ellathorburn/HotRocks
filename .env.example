EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only values belong in Supabase secrets, never in EXPO_PUBLIC_ values.
# These are read by scripts/strava-connect.mjs when connecting Strava once, and
# must also be set as Supabase function secrets for post-to-strava:
#   npx supabase secrets set STRAVA_CLIENT_ID=... STRAVA_CLIENT_SECRET=... STRAVA_TOKEN_ENCRYPTION_KEY=...
# Generate the key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# STRAVA_CLIENT_ID=
# STRAVA_CLIENT_SECRET=
# STRAVA_TOKEN_ENCRYPTION_KEY=
#
# Only scripts/strava-connect.mjs needs these. Put the service role key in an
# ignored `.env.scripts` rather than here: Expo loads `.env`, so a secret in it
# reaches the dev server for no reason. SUPABASE_URL falls back to
# EXPO_PUBLIC_SUPABASE_URL, so it does not need setting twice.
# SUPABASE_SERVICE_ROLE_KEY=
# HOTROCKS_ATHLETE_EMAIL=
