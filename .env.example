EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Strava runs entirely server-side. These belong in Supabase function secrets,
# never in this file and never in an EXPO_PUBLIC_ value:
#   npx supabase secrets set STRAVA_CLIENT_ID=... STRAVA_CLIENT_SECRET=... STRAVA_TOKEN_ENCRYPTION_KEY=...
# Generate the encryption key with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Strava's Authorization Callback Domain must be the project's functions host,
# e.g. <project-ref>.supabase.co: the browser is redirected to the
# strava-callback function, not back into the app.
